root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{toml,ini}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.py]
indent_size = 4

[*.{js,ts,jsx,tsx}]
indent_size = 2

[Makefile]
indent_style = tab